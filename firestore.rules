rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Marketplace Items (viewable by everyone, permanently stored in Firestore)
    match /items/{itemId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Rental Bookings
    match /bookings/{bookingId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Exchange Proposals
    match /proposals/{proposalId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Chat Conversations & Messages
    match /conversations/{conversationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['id', 'rating', 'comment', 'reviewerName', 'createdAt']) &&
        data.keys().hasOnly(['id', 'rating', 'comment', 'improvementAreas', 'reviewerName', 'userId', 'createdAt']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 3 && data.comment.size() <= 500 &&
        data.reviewerName is string && data.reviewerName.size() >= 1 && data.reviewerName.size() <= 80 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('improvementAreas' in data) || (data.improvementAreas is list && data.improvementAreas.size() <= 10)) &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128));
    }

    // Platform Ratings & Feedback Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId) && isValidReview(incoming()) && incoming().id == reviewId;
      allow update, delete: if false;
    }
  }
}
