{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "avatar": { "type": "string" },
        "gender": { "type": "string" },
        "country": { "type": "string" },
        "city": { "type": "string" },
        "location": { "type": "string" },
        "neighborhood": { "type": "string" },
        "currency": { "type": "string" },
        "currencyCode": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "phoneVerified": { "type": "boolean" },
        "phoneVerifiedAt": { "type": "string" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "verified": { "type": "boolean" },
        "role": { "type": "string", "description": "Account role (member or admin)" },
        "isAdmin": { "type": "boolean", "description": "Whether this account is an official platform administrator" },
        "memberSince": { "type": "string" },
        "bio": { "type": "string" },
        "savedItemIds": { "type": "array" },
        "preferredHandover": { "type": "array" },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" }
      },
      "required": ["id", "name", "email"]
    },
    "Item": {
      "title": "Item",
      "description": "Resource listing for rent or exchange",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "condition": { "type": "string" },
        "listingType": { "type": "string" },
        "priceDaily": { "type": "number" },
        "priceAmount": { "type": "number" },
        "priceDuration": { "type": "string" },
        "priceRateText": { "type": "string" },
        "currencySymbol": { "type": "string" },
        "availableTimeWindow": { "type": "string" },
        "depositAmount": { "type": "number" },
        "minRentalDays": { "type": "number" },
        "images": { "type": "array" },
        "owner": { "type": "object" },
        "location": { "type": "object" },
        "preferredExchangeItems": { "type": "array" },
        "exchangeNotes": { "type": "string" },
        "isAvailable": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "category", "listingType", "owner", "priceDaily"]
    },
    "RentalBooking": {
      "title": "RentalBooking",
      "description": "Rental booking record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "itemTitle": { "type": "string" },
        "ownerId": { "type": "string" },
        "renterId": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "grandTotal": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "itemId", "ownerId", "renterId", "status"]
    },
    "ExchangeProposal": {
      "title": "ExchangeProposal",
      "description": "Item exchange barter offer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "itemOwnerId": { "type": "string" },
        "proposerId": { "type": "string" },
        "offeredItemTitle": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "itemId", "itemOwnerId", "proposerId", "offeredItemTitle", "status"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Chat thread between renter/trader and owner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "participantIds": { "type": "array" },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "string" }
      },
      "required": ["id", "itemId", "participantIds"]
    },
    "PlatformReview": {
      "title": "PlatformReview",
      "description": "User rating and feedback review submitted for ResourceBox",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "minLength": 3, "maxLength": 500 },
        "improvementAreas": { "type": "array" },
        "reviewerName": { "type": "string", "maxLength": 80 },
        "userId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "rating", "comment", "reviewerName", "createdAt"]
    },
    "UserFollow": {
      "title": "UserFollow",
      "description": "Follow relationship between community users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 260 },
        "followerId": { "type": "string", "maxLength": 128 },
        "followerName": { "type": "string", "maxLength": 80 },
        "followerUsername": { "type": "string", "maxLength": 32 },
        "followerAvatar": { "type": "string", "maxLength": 1000 },
        "followingId": { "type": "string", "maxLength": 128 },
        "followingName": { "type": "string", "maxLength": 80 },
        "followingUsername": { "type": "string", "maxLength": 32 },
        "followingAvatar": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "followerId", "followingId", "createdAt"]
    },
    "UploadNotification": {
      "title": "UploadNotification",
      "description": "Notification sent to followers when a followed creator uploads a product",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 260 },
        "recipientId": { "type": "string", "maxLength": 128 },
        "creatorId": { "type": "string", "maxLength": 128 },
        "creatorName": { "type": "string", "maxLength": 80 },
        "creatorUsername": { "type": "string", "maxLength": 32 },
        "creatorAvatar": { "type": "string", "maxLength": 1000 },
        "itemId": { "type": "string", "maxLength": 128 },
        "itemTitle": { "type": "string", "maxLength": 160 },
        "itemImage": { "type": "string", "maxLength": 100000 },
        "itemCategory": { "type": "string", "maxLength": 64 },
        "priceRateText": { "type": "string", "maxLength": 64 },
        "listingType": { "type": "string", "maxLength": 32 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "recipientId", "creatorId", "creatorName", "itemId", "itemTitle", "itemCategory", "listingType", "read", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles"
    },
    "/items/{itemId}": {
      "schema": "Item",
      "description": "Marketplace resource items"
    },
    "/bookings/{bookingId}": {
      "schema": "RentalBooking",
      "description": "Rental reservations"
    },
    "/proposals/{proposalId}": {
      "schema": "ExchangeProposal",
      "description": "Exchange barter proposals"
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "Chat conversations between users"
    },
    "/reviews/{reviewId}": {
      "schema": "PlatformReview",
      "description": "Platform ratings and feedback reviews"
    },
    "/follows/{followId}": {
      "schema": "UserFollow",
      "description": "Follower-following relationships"
    },
    "/notifications/{notificationId}": {
      "schema": "UploadNotification",
      "description": "Upload update notifications for followers"
    }
  }
}
